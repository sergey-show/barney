# Harbor eval adapter (evals/harbor). Copy to `.env` and edit.
# Loaded by pydantic-settings in `settings.py`.

# OpenAI-compatible endpoint used by ollama/* and local/* models
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=local

# Optional aliases (fall back to OPENAI_* when empty)
# BARNEY_API_BASE=
# BARNEY_API_KEY=

# Cloud providers (optional)
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Vendored installers for the task container
BUN_LINUX_URL=https://github.com/oven-sh/bun/releases/download/bun-v1.3.14/bun-linux-x64.zip
BUN_LINUX_ZIP=/tmp/barney-eval-vendor/bun-linux-x64.zip
UV_LINUX_URL=https://github.com/astral-sh/uv/releases/download/0.9.5/uv-x86_64-unknown-linux-gnu.tar.gz
UV_LINUX_TAR=/tmp/barney-eval-vendor/uv-x86_64-unknown-linux-gnu.tar.gz
